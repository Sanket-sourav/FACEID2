# =============================================================================
# Attendance app - environment variables (copy this file to ".env")
#
# To use:  copy this file to ".env"  in the project folder, then fill in the
# values (no quotes needed). Keep .env private - it is already gitignored.
# These are read automatically when you run `python main.py serve`.
# =============================================================================

# --- LOGIN (important if others could reach the app) -------------------------
# If both are set, the phone/website shows a login page and only a logged-in
# teacher can upload / change attendance.
ATTENDANCE_TEACHER_USERNAME=teacher1
ATTENDANCE_TEACHER_PASSWORD=change-me-to-a-strong-password

# --- GOOGLE SHEETS ----------------------------------------------------------
# The spreadsheet ID from the URL of your master sheet, e.g.
#   https://docs.google.com/spreadsheets/d/1AbC...xyz/edit   -> 1AbC...xyz
ATTENDANCE_SHEET_ID=

# LEAVE BLANK to use secrets/service-account.json (default).
# Or: path to any service-account key file.
#ATTENDANCE_CREDENTIALS_FILE=C:\full\path\to\service-account.json

# Optional: paste the WHOLE service-account JSON here instead of a file
# (easiest option on Railway). Leave blank if using the file above.
#ATTENDANCE_CREDENTIALS_JSON={"type": "service_account", ...}

# --- OPTIONAL master token (for scripts / programs) -------------------------
# If set, this is also accepted as Authorization: Bearer <token>.
#ATTENDANCE_ACCESS_TOKEN=some-secret-token